/ The account area is a Redmine 7 flyout dropdown, so the sudo toggle itself
/ lives inside it as a proper menu item (see account_menu in init.rb).
- if User.current.sudoer?
  / Append the current page as back_url so escalating to admin returns here.
  javascript:
    (function() {
      var link = document.querySelector('a.sudo-toggle');
      if (link) link.href = link.href.split('?')[0] + '?back_url=' + encodeURIComponent(location.pathname + location.search);
    })();
  / Flag the account avatar with a warning ring while admin permission is active.
  - if User.current.admin?
    javascript:
      document.getElementById('account')?.classList.add('sudo-active');
